<% provide(:title, "会員登録") %>

<div class="card">
  <h1 class="text-2xl font-bold text-gray-800 mb-6 flex justify-center">会員登録</h1>

  <%= form_with model: @user, class: "space-y-5" do |f| %>
  <% if @user.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 p-4 mb-4 rounded-lg">
      <ul class="list-disc list-inside text-sm">
        <% @user.errors.each do |error| %>
          <li><%= error.message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
    <div>
      <%= f.label :name, "名前", class: "form-label" %>
      <%= f.text_field :name, class: "form-input" %>
    </div>

    <div>
      <%= f.label :email, "メールアドレス", class: "form-label" %>
      <%= f.email_field :email, class: "form-input" %>
    </div>

    <div>
      <%= f.label :password, "パスワード", class: "form-label" %>
      <%= f.password_field :password, class: "form-input" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "パスワード確認", class: "form-label" %>
      <%= f.password_field :password_confirmation, class: "form-input" %>
    </div>

    <div>
      <%= f.submit "登録", class: "btn-primary" %>
    </div>
  <% end %>
</div>