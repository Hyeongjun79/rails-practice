<% provide(:title, "会員登録") %>

<div class="card">
  <h1 class="text-2xl font-bold text-gray-800 mb-6 flex justify-center">会員登録</h1>

  <%= form_with model: @user, class: "space-y-5" do |f| %>
    <div>
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-input" %>
    </div>

    <div>
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, class: "form-input" %>
    </div>

    <div>
      <%= f.submit "登録", class: "btn-primary" %>
    </div>
  <% end %>
</div>