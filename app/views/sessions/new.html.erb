<% provide(:title, "ログイン") %>

<div class="card">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">ログイン</h1>

  <%= form_with url: login_path, scope: :session, class: "space-y-5" do |f| %>
    <div>
      <%= f.label :email, "メールアドレス", class: "form-label" %>
      <%= f.email_field :email, class: "form-input" %>
    </div>

    <div>
      <%= f.label :password, "パスワード", class: "form-label" %>
      <%= f.password_field :password, class: "form-input" %>
    </div>

    <div>
      <%= f.submit "ログイン", class: "btn-primary" %>
    </div>
  <% end %>
</div>